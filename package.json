{
  "name": "suica",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.cjs",
    "start": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test:translations": "node scripts/check-translations.mjs",
    "test:spaces": "node --test scripts/space-availability.test.mjs",
    "preview": "vite preview",
    "test": "node --test scripts/*.test.mjs && vitest run",
    "test:security": "node --test scripts/local-server-security.test.mjs && vitest run tests/security.test.ts",
    "security:check": "npm run test:security && npm audit --audit-level=low",
    "typecheck:backend": "tsc --noEmit -p convex/tsconfig.json",
    "verify": "npm test && npm run test:translations && npm run typecheck:backend"
  },
  "dependencies": {
    "@convex-dev/rate-limiter": "^0.4.2",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/interaction": "^6.1.22",
    "@fullcalendar/react": "^6.1.22",
    "@fullcalendar/timegrid": "^6.1.22",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "clsx": "^2.1.1",
    "convex": "^1.48.0",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "i18next": "^26.5.8",
    "lucide-react": "^1.61.0",
    "node-ical": "^0.27.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.6",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.6",
    "convex-test": "^0.0.65",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "postcss": "^8.5.31",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "tailwindcss": {
      "postcss-selector-parser": "^7.1.6"
    },
    "postcss-nested": {
      "postcss-selector-parser": "^7.1.6"
    }
  },
  "engines": {
    "node": ">=24.13.0 <25 || >=26.0.0"
  }
}
